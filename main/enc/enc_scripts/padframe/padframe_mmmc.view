# sdc file specify
create_constraint_mode -name cons_mode -sdc_files {../syn/output/padframe/padframe.sdc}

# create delay corner
create_delay_corner -name typ_delay -rc_corner {typ_rc} -library_set {typical}
create_delay_corner -name fast_delay -rc_corner {fast_rc} -library_set {fast}
create_delay_corner -name slow_delay -rc_corner {slow_rc} -library_set {slow}

# analysis view
create_analysis_view -name typ_analysis -constraint_mode {cons_mode} -delay_corner {typ_delay}
create_analysis_view -name fast_analysis -constraint_mode {cons_mode} -delay_corner {fast_delay}
create_analysis_view -name slow_analysis -constraint_mode {cons_mode} -delay_corner {slow_delay}

set_analysis_view -setup {fast_analysis typ_analysis slow_analysis} -hold {fast_analysis typ_analysis slow_analysis}
